# Backend API base URL — consumed by lib/api.js via process.env.NEXT_PUBLIC_API_URL
# NEXT_PUBLIC_ prefix makes this available in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# JWT secret — must match the JWT_SECRET in backend/.env
# Used by proxy.js to verify the token cookie at the edge.
# Server-only (no NEXT_PUBLIC_ prefix).
JWT_SECRET=your_jwt_secret_here
